        <mxCell id="GJ-ZEg_Tp73-UWNDR1aK-19" value="/authenticate + basic auth (login, refresh)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
